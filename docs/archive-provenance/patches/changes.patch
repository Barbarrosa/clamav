diff --git a/tools/compact-memory/onpair-probe/src/main.rs b/tools/compact-memory/onpair-probe/src/main.rs
new file mode 100644
index 0000000..bf70854
--- /dev/null
+++ b/tools/compact-memory/onpair-probe/src/main.rs
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MIT
+// Standalone research executable; never linked into the scanner.
+use std::{env, fs, hint::black_box, mem::{size_of,MaybeUninit}, time::Instant};
+use onpair::{Column, CompactDictionary, Config, DECODE_PADDING, MaxDictBits, OwnedDictionaryStorage, Threshold, try_decode_into};
+fn rng(s: &mut u64)->u64 {*s^=*s<<13;*s^=*s>>7;*s^=*s<<17;*s}
+fn main() {
+    let args:Vec<_>=env::args().collect(); assert_eq!(args.len(),4,"DATA INDEX DICT_BITS");
+    let data=fs::read(&args[1]).unwrap(); let raw_index=fs::read(&args[2]).unwrap(); assert_eq!(raw_index.len()%4,0);
+    let encoded:Vec<u32>=raw_index.chunks_exact(4).map(|x|u32::from_le_bytes(x.try_into().unwrap())).collect();
+    let offsets:Vec<u32>=encoded.iter().map(|v|v&0x7fffffff).collect(); let rows=offsets.len()-1;
+    assert_eq!(offsets[0],0);assert_eq!(offsets[rows] as usize,data.len());
+    let mut wide=vec![0u8;rows.div_ceil(8)];let mut maxlen=0;let mut longest=0;
+    for i in 0..rows {assert!(offsets[i]<=offsets[i+1]); let n=(offsets[i+1]-offsets[i]) as usize;
+        if n>maxlen {maxlen=n;longest=i;} if encoded[i]>>31 !=0 {assert_eq!(n%2,0);wide[i/8]|=1<<(i%8);}}
+    let bits:u8=args[3].parse().unwrap();
+    let cfg=Config{max_dict_bits:MaxDictBits::new(bits).unwrap(),threshold:Threshold::new(0.15).unwrap(),seed:Some(42)};
+    let start=Instant::now(); let mut col=Column::<u32>::compress(&data,&offsets,cfg).unwrap(); let build=start.elapsed().as_secs_f64();
+    col.codes.shrink_to_fit();col.row_offsets.shrink_to_fit();
+    let (dict, codes, row_offsets)=col.into_raw();let (mut db,mut di)=dict.into_raw();db.shrink_to_fit();di.shrink_to_fit();
+    let dict_bytes=db.len()+di.len()*4;let dict_capacity=db.capacity()+di.capacity()*4;
+    let dict=CompactDictionary::validate(OwnedDictionaryStorage::new(db,di)).unwrap();
+    let col=Column{dict,codes,row_offsets}; let view=col.view();
+    let mut scratch=vec![MaybeUninit::<u8>::uninit();maxlen+DECODE_PADDING];
+    for i in 0..rows {
+        let n=try_decode_into(view.row_codes(i),view.dict,&mut scratch).unwrap();
+        // Safe decoder initialized exactly its returned prefix.
+        let out=unsafe{std::slice::from_raw_parts(scratch.as_ptr().cast::<u8>(),n)};
+        assert_eq!(out,&data[offsets[i] as usize..offsets[i+1] as usize]);
+        assert_eq!((wide[i/8]>>(i%8))&1,(encoded[i]>>31) as u8);
+    }
+    let too_short=try_decode_into(view.row_codes(longest),view.dict,&mut []).is_err();assert!(too_short);
+    let malformed=CompactDictionary::validate_safety(OwnedDictionaryStorage::new(vec![0;32],vec![0,17])).is_err();assert!(malformed);
+    let payload=col.codes.len()*2;let index=col.row_offsets.len()*4;
+    let total=payload+index+dict_bytes+wide.len()+scratch.len()+size_of::<Column<u32>>()+2*size_of::<Vec<u8>>();
+    let allocated=col.codes.capacity()*2+col.row_offsets.capacity()*4+dict_capacity+wide.capacity()+scratch.capacity()+size_of::<Column<u32>>()+2*size_of::<Vec<u8>>();
+    println!("{{\"kind\":\"onpair\",\"dict_bits\":{bits},\"rows\":{rows},\"raw_payload_bytes\":{},\"codes\":{},\"code_bytes\":{payload},\"index_bytes\":{index},\"dictionary_bytes\":{dict_bytes},\"width_bitmap_bytes\":{},\"scratch_bytes\":{},\"total_layout_bytes\":{total},\"allocated_layout_bytes\":{allocated},\"build_seconds\":{build},\"every_token_verified\":true,\"too_small_output_rejected\":{too_short},\"malformed_dictionary_rejected\":{malformed}}}",data.len(),col.codes.len(),wide.len(),scratch.len());
+    let mut seed=261027;let count=262144;
+    for mode in 0..5 {
+        let queries:Vec<usize>=(0..count).map(|i|match mode {0=>(rng(&mut seed) as usize)%rows,1=>i%rows,2=>i%32,3=>longest,_=>if i%2==0 {0}else{rows-1}}).collect();
+        for trial in 0..5 {
+            let mut times=[0.;2];let mut checksums=[0u64;2];
+            for order in 0..2 {let packed=order^(trial&1);let start=Instant::now();let mut sum=0u64;
+                for &i in &queries {
+                    let out=if packed==1 {let n=try_decode_into(view.row_codes(i),view.dict,&mut scratch).unwrap(); unsafe{std::slice::from_raw_parts(scratch.as_ptr().cast::<u8>(),n)}} else {&data[offsets[i] as usize..offsets[i+1] as usize]};
+                    let out=black_box(out);sum+=out.len() as u64;if !out.is_empty(){sum+=out[0] as u64+out[out.len()-1] as u64;}
+                }
+                checksums[packed]=black_box(sum);times[packed]=start.elapsed().as_secs_f64();
+            }
+            assert_eq!(checksums[0],checksums[1]);
+            println!("{{\"kind\":\"onpair_timing\",\"dict_bits\":{bits},\"mode\":{mode},\"trial\":{trial},\"queries\":{count},\"raw_seconds\":{},\"packed_seconds\":{},\"checksum\":{}}}",times[0],times[1],checksums[0]);
+        }
+    }
+}
diff --git a/tools/compact-memory/probe_hash_equivalence.c b/tools/compact-memory/probe_hash_equivalence.c
new file mode 100644
index 0000000..28d548b
--- /dev/null
+++ b/tools/compact-memory/probe_hash_equivalence.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Build separately against baseline and fork. Hash exact return codes/names
+ * for canonical present, mutated-digest and alternate-size queries. Raw
+ * signatures and names are never written by this diagnostic.
+ */
+#include "clamav-config.h"
+#include "clamav.h"
+#include "others.h"
+#include "matcher.h"
+#include <openssl/evp.h>
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/resource.h>
+
+struct query { uint32_t size; unsigned char purpose, type, digest[32]; };
+static struct query *queries;
+static size_t count, capacity;
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return t.tv_sec+t.tv_nsec*1e-9; }
+static long rss(void) {
+    FILE *f=fopen("/proc/self/status","r");char line[256];long n=-1;
+    if(!f)return -1;
+    while(fgets(line,sizeof(line),f))if(sscanf(line,"VmRSS: %ld kB",&n)==1)break;
+    fclose(f);return n;
+}
+static void add(unsigned purpose,unsigned type,uint32_t size,const uint8_t *d) {
+    if(count==capacity) {capacity=capacity?capacity*2:4096;queries=realloc(queries,capacity*sizeof(*queries));assert(queries);}
+    struct query *q=&queries[count++];memset(q,0,sizeof(*q));q->purpose=purpose;q->type=type;q->size=size;memcpy(q->digest,d,cli_hash_len(type));
+}
+static void collect(struct cli_matcher *r,unsigned purpose) {
+    if(!r)return;
+    for(unsigned t=0;t<CLI_HASH_AVAIL_TYPES;t++) {
+#ifdef ENABLE_FLAT_HASH_STORE
+        if(r->hm.compiled) {
+            const struct cli_hash_compiled *g=&r->hm.compiled[t];
+            for(size_t b=0;b<=g->buckets;b++) {
+                size_t end=b==g->buckets?g->items:g->starts[b+1];
+                for(size_t j=g->starts[b];j<end;j++)add(purpose,t,b==g->buckets?0:g->sizes[b],g->hashes+j*cli_hash_len(t));
+            }
+            continue;
+        }
+#endif
+        const struct cli_htu32_element *item=NULL;
+        while((item=cli_htu32_next(&r->hm.sizehashes[t],item))) {
+            const struct cli_sz_hash *s=item->data.as_ptr;
+            for(size_t j=0;j<s->items;j++)add(purpose,t,item->key,s->hash_array+j*cli_hash_len(t));
+        }
+        const struct cli_sz_hash *s=&r->hwild.hashes[t];
+        for(size_t j=0;j<s->items;j++)add(purpose,t,0,s->hash_array+j*cli_hash_len(t));
+    }
+}
+static int cmp(const void *a,const void *b) {
+    const struct query *x=a,*y=b;
+    if(x->purpose!=y->purpose)return (x->purpose>y->purpose)-(x->purpose<y->purpose);
+    if(x->type!=y->type)return (x->type>y->type)-(x->type<y->type);
+    if(x->size!=y->size)return (x->size>y->size)-(x->size<y->size);
+    return memcmp(x->digest,y->digest,32);
+}
+static uint64_t random64(uint64_t *s){*s^=*s<<13;*s^=*s>>7;*s^=*s<<17;return *s;}
+int main(int argc,char **argv) {
+    if(argc!=3)return 2;
+    assert(cl_init(CL_INIT_DEFAULT)==CL_SUCCESS);
+    struct cl_engine *e=cl_engine_new();assert(e);
+    assert(cl_engine_set_str(e,CL_ENGINE_CVDCERTSDIR,argv[2])==CL_SUCCESS);
+    assert(cl_engine_set_num(e,CL_ENGINE_DISABLE_CACHE,1)==CL_SUCCESS);
+    unsigned signatures=0;double start=now();
+    assert(cl_load(argv[1],e,&signatures,CL_DB_STDOPT)==CL_SUCCESS);
+    double loaded=now();long load_rss=rss();
+    assert(cl_engine_compile(e)==CL_SUCCESS);
+    double compiled=now();long compile_rss=rss();struct rusage usage;assert(!getrusage(RUSAGE_SELF,&usage));
+    struct cli_matcher *roots[]={e->hm_hdb,e->hm_mdb,e->hm_imp,e->hm_fp};
+    for(unsigned p=0;p<4;p++)collect(roots[p],p);
+    qsort(queries,count,sizeof(*queries),cmp);
+    EVP_MD_CTX *hash=EVP_MD_CTX_new();assert(hash);assert(EVP_DigestInit_ex(hash,EVP_sha256(),NULL)==1);
+    uint64_t hits[3]={0,0,0};
+    for(size_t i=0;i<count;i++)for(unsigned variant=0;variant<3;variant++) {
+        const struct query *q=&queries[i];uint8_t unaligned[33];memcpy(unaligned+1,q->digest,32);
+        uint32_t size=q->size;
+        if(variant==1)unaligned[cli_hash_len(q->type)]^=1;
+        if(variant==2)size=size==UINT32_MAX-1?1:size+1;
+        const char *name="UNCHANGED";
+        cl_error_t r=size?cli_hm_scan(unaligned+1,size,&name,roots[q->purpose],q->type):cli_hm_scan_wild(unaligned+1,&name,roots[q->purpose],q->type);
+        unsigned char code[2]={(unsigned char)r,(unsigned char)!!name};
+        assert(EVP_DigestUpdate(hash,code,sizeof(code))==1);
+        if(name)assert(EVP_DigestUpdate(hash,name,strlen(name)+1)==1);
+        hits[variant]+=r==CL_VIRUS;
+    }
+    unsigned char digest[32];unsigned length;assert(EVP_DigestFinal_ex(hash,digest,&length)==1);EVP_MD_CTX_free(hash);
+    char hex[65];for(unsigned i=0;i<32;i++)sprintf(hex+2*i,"%02x",digest[i]);
+    printf("{\"kind\":\"hash_equivalence\",\"signatures\":%u,\"records\":%zu,\"queries\":%zu,\"result_sha256\":\"%s\",\"hits\":[%llu,%llu,%llu],\"load_seconds\":%.9f,\"compile_seconds\":%.9f,\"load_rss_kib\":%ld,\"compiled_rss_kib\":%ld,\"compile_peak_rss_kib\":%ld}\n",signatures,count,count*3,hex,(unsigned long long)hits[0],(unsigned long long)hits[1],(unsigned long long)hits[2],loaded-start,compiled-loaded,load_rss,compile_rss,usage.ru_maxrss);
+    for(unsigned mode=0;mode<4;mode++)for(unsigned rep=0;rep<8;rep++) {
+        uint64_t state=12345,sum=0;start=now();
+        for(unsigned i=0;i<262144;i++) {
+            size_t index=mode==2?i%32:mode==1?i%count:random64(&state)%count;
+            const struct query *q=&queries[index];uint32_t size=mode==3?q->size^0x40000000:q->size;
+            sum+=cli_hm_have_size(roots[q->purpose],q->type,size);
+        }
+        printf("{\"kind\":\"size_lookup\",\"mode\":%u,\"repeat\":%u,\"ns_per_query\":%.4f,\"checksum\":%llu}\n",mode,rep,(now()-start)*1e9/262144,(unsigned long long)sum);
+    }
+    free(queries);cl_engine_free(e);return 0;
+}
