+        rust.append(f'println!("{struct}.sizeof={{}}", std::mem::size_of::<sys::{struct}>());')
+        for member in members:
+            c.append(f'printf("{struct}.{member}=%zu\\n", offsetof(struct {struct}, {member}));')
