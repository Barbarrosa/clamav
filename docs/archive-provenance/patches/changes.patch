diff --git a/tools/compact-memory/assess_floor.py b/tools/compact-memory/assess_floor.py
new file mode 100644
index 0000000..8718c6b
--- /dev/null
+++ b/tools/compact-memory/assess_floor.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Reject an infeasible resident boundary from a matching engine_census run.
+
+This is a lower-bound check, not an acceptance test: omitted subsystems can
+only increase the total. A subtotal below the budget is inconclusive.
+"""
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('census', type=Path)
+    parser.add_argument('--budget-mb', type=int, default=200, help='Decimal MB, not MiB')
+    args = parser.parse_args()
+    if args.budget_mb <= 0:
+        parser.error('budget must be positive')
+    records = [json.loads(line) for line in args.census.read_text().splitlines() if line.strip()]
+    floors = [r for r in records if r.get('kind') == 'resident_floor_components']
+    if len(floors) != 1:
+        parser.error('expected exactly one resident_floor_components record')
+    floor = floors[0]
+    keys = ('ac_core_bytes', 'unique_name_bytes', 'logical_records_bytes')
+    if any(type(floor.get(k)) is not int or floor[k] < 0 for k in keys):
+        parser.error('invalid component byte count')
+    subtotal = sum(floor[k] for k in keys)
+    budget = args.budget_mb * 1_000_000
+    print(json.dumps({
+        'architecture': 'resident routing, stable interned names, current logical descriptors',
+        'components': {k: floor[k] for k in keys},
+        'subtotal_bytes': subtotal,
+        'subtotal_mib': subtotal / 1048576,
+        'budget_bytes': budget,
+        'gate': 'blocked' if subtotal > budget else 'inconclusive',
+        'concurrent_reload_subtotal_bytes': 2 * subtotal,
+        'excludes': ['cache', 'scan and parser state', 'code and runtime',
+                     'logical expression and target metadata payloads',
+                     'other resident matchers and compatibility objects',
+                     'allocator overhead', 'build scratch', 'kernel file cache'],
+        'interpretation': 'A bound for the planned layouts, not an information-theoretic limit.'
+    }, indent=2))
+    if subtotal > budget:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/compact-memory/check_alert_order.py b/tools/compact-memory/check_alert_order.py
new file mode 100644
index 0000000..f9cc2c7
--- /dev/null
+++ b/tools/compact-memory/check_alert_order.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Compare first-alert selection and ordered all-match alerts across libraries.
+
+Harmless markers and custom signatures stress allocator-address tie breaking.
+The all-match multiset and ordered sequence are reported separately.
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+
+def digest(lines):
+    return hashlib.sha256(('\n'.join(lines) + '\n').encode()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--clamscan', type=Path, required=True)
+    parser.add_argument('--library', action='append', required=True, help='LABEL=LIBRARY_DIRECTORY')
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--rules', type=int, default=10000)
+    parser.add_argument('--expect-equal', action='append', default=[], help='LABEL=LABEL; check both modes')
+    args = parser.parse_args()
+    if args.rules < 1:
+        parser.error('rules must be positive')
+    out = args.output.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    database, target = out / 'ordering.ndb', out / 'marker.bin'
+    with database.open('w') as stream:
+        for i in range(args.rules):
+            stream.write(f'Foundations.Order.{i:05d}:0:*:41424344??464748\n')
+            body = hashlib.sha256(f'distractor/{i}'.encode()).digest()[:12].hex()
+            stream.write(f'Foundations.Other.{i:05d}:0:*:{body[:12]}??{body[14:]}\n')
+    target.write_bytes(b'\0' * 1024 + b'ABCDEFGH' + b'\0' * 1024)
+    libraries, hashes, results = {}, {}, {}
+    for spec in args.library:
+        label, sep, path = spec.partition('=')
+        if not sep or not re.fullmatch('[a-z0-9_-]+', label) or label in libraries:
+            parser.error('expected unique LABEL=PATH')
+        libraries[label] = Path(path).resolve()
+        hashes[label] = hashlib.sha256((libraries[label] / 'libclamav.so').read_bytes()).hexdigest()
+    for mode in ('first', 'all'):
+        results[mode] = {}
+        for label, lib in libraries.items():
+            env = os.environ.copy()
+            env['LD_LIBRARY_PATH'] = str(lib)
+            command = [str(args.clamscan.resolve()), '--no-summary', '--stdout', '-d', str(database), str(target)]
+            if mode == 'all':
+                command.append('--allmatch')
+            result = subprocess.run(command, env=env, capture_output=True, text=True)
+            if result.returncode != 1:
+                raise RuntimeError(f'{label}/{mode}: {result.returncode}: {result.stderr}')
+            lines = result.stdout.splitlines()
+            prefix = str(target) + ': '
+            if not lines or any(not line.startswith(prefix) or not line.endswith(' FOUND') for line in lines):
+                raise RuntimeError('Unexpected scanner output')
+            names = [line[len(prefix):-len(' FOUND')] for line in lines]
+            results[mode][label] = {'count': len(names), 'ordered_sha256': digest(names),
+                                    'multiset_sha256': digest(sorted(names)),
+                                    'distinct_names': len(Counter(names)),
+                                    'first': names[0], 'last': names[-1]}
+    failures = []
+    for pair in args.expect_equal:
+        left, sep, right = pair.partition('=')
+        if not sep or left not in libraries or right not in libraries:
+            parser.error('unknown library in --expect-equal')
+        for mode in results:
+            if results[mode][left] != results[mode][right]:
+                failures.append(f'{mode}: {left} != {right}')
+    report = {'kind': 'duplicate_alert_order_differential', 'rule_pairs': args.rules,
+              'database_sha256': hashlib.sha256(database.read_bytes()).hexdigest(),
+              'libraries': hashes, 'results': results, 'required_comparison_failures': failures}
+    (out / 'results.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps(report, indent=2))
+    if failures:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()
