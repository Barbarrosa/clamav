+        subprocess.run(['rustc', '-A', 'warnings', str(temp / 'layout.rs'),
+                        '-o', str(temp / 'rust')], check=True)
+        expected = subprocess.check_output([str(temp / 'c')], text=True)
+        actual = subprocess.check_output([str(temp / 'rust')], text=True)
