+uint32_t cl_subset_runtime_capabilities(void)
+{
+    return have_rar ? 1U : 0U;
+}
+
+const char *cl_subset_guard_version(void)
+{
+    return CL_SUBSET_GUARD_VERSION;
+}
+
+cl_error_t cl_engine_enable_subset_guard(struct cl_engine *engine, clcb_subset_guard notify)
+{
+    if (!engine) return CL_ENULLARG;
+    if (engine->dboptions & CL_DB_COMPILED) return CL_ESTATE;
+    engine->subset_guard_enabled = true;
+    engine->cb_subset_guard = notify;
+    engine->engine_options |= ENGINE_OPTIONS_DISABLE_CACHE;
+    return CL_SUCCESS;
+}
+
+cl_error_t cl_subset_validation_stats(const struct cl_engine *engine,
+                                     uint64_t counters[CL_SUBSET_VALIDATION_COUNTERS])
+{
+    const struct cli_matcher *r;
+    unsigned purpose, type;
+    if (!engine || !counters) return CL_ENULLARG;
+    memset(counters, 0, CL_SUBSET_VALIDATION_COUNTERS * sizeof(*counters));
+    r = engine->root ? engine->root[TARGET_PE] : NULL;
+    if (r) {
+        const uint64_t values[] = {r->bm_patterns, r->bm_reloff_num, r->bm_absoff_num,
+            r->ac_partsigs, r->ac_nodes, r->ac_lists, r->ac_patterns, r->ac_lsigs,
+            r->ac_reloff_num, r->ac_absoff_num, r->pcre_metas, r->pcre_reloff_num,
+            r->pcre_absoff_num, r->bcomp_metas, r->linked_bcs, r->soff_len,
+            r->ac_lsig_slots};
+        memcpy(counters, values, sizeof(values));
+    }
+    for (purpose = 0; purpose < 2; purpose++) {
+        uint64_t items = 0;
+        r = purpose ? engine->hm_imp : engine->hm_mdb;
+        if (!r) continue;
+        for (type = 0; type < CLI_HASH_AVAIL_TYPES; type++) {
+            const struct cli_htu32_element *element = NULL;
+            items += r->hwild.hashes[type].items;
+            while ((element = cli_htu32_next(&r->hm.sizehashes[type], element)))
+                items += ((const struct cli_sz_hash *)element->data.as_ptr)->items;
+        }
+        counters[17 + purpose] = items;
+    }
+    return CL_SUCCESS;
+}
+
+void cli_subset_guard(cli_ctx *ctx, uint32_t reasons)
+{
+    if (ctx && ctx->engine && ctx->engine->subset_guard_enabled) {
+        uint32_t newly_reached = reasons & ~ctx->subset_guard_flags;
+        ctx->subset_guard_flags |= reasons;
+        if (ctx->fmap) ctx->fmap->dont_cache_flag = true;
+        if (newly_reached && ctx->engine->cb_subset_guard)
+            ctx->engine->cb_subset_guard(ctx->subset_guard_flags, ctx->cb_ctx);
+    }
 }
 
