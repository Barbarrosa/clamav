     // Lines to append to the database
     additions: Vec<u8>,
+    // Only a bounded window of edits/additions is retained. Sorted edit runs
+    // are merged on disk, preserving last-command-wins for duplicate lines.
+    edits_run: Option<tempfile::NamedTempFile>,
+    additions_run: Option<tempfile::NamedTempFile>,
+    edit_bytes: usize,
+}
+
+// Buffer sizes are implementation windows, not limits on accepted databases.
+const EDIT_WINDOW_BYTES: usize = 1024 * 1024;
+
+fn spill_error(error: std::io::Error) -> InputError {
+    InputError::ProcessingString(format!("CDIFF spill I/O: {}", error))
+}
+
+fn write_edit<W: Write>(out: &mut W, edit: &EditNode) -> std::io::Result<()> {
+    out.write_all(&(edit.line_no as u64).to_le_bytes())?;
+    out.write_all(&(edit.orig_line.len() as u64).to_le_bytes())?;
+    out.write_all(
+        &edit
+            .new_line
+            .as_ref()
+            .map_or(u64::MAX, |v| v.len() as u64)
+            .to_le_bytes(),
+    )?;
+    out.write_all(&edit.orig_line)?;
+    if let Some(line) = &edit.new_line {
+        out.write_all(line)?;
+    }
+    Ok(())
+}
+
+fn read_edit<R: Read>(input: &mut R) -> std::io::Result<Option<EditNode>> {
+    let mut header = [0u8; 24];
+    if input.read(&mut header[..1])? == 0 {
+        return Ok(None);
+    }
+    input.read_exact(&mut header[1..])?;
+    let number = u64::from_le_bytes(header[..8].try_into().unwrap());
+    let old_len = u64::from_le_bytes(header[8..16].try_into().unwrap());
+    let new_len = u64::from_le_bytes(header[16..24].try_into().unwrap());
+    let limit = update_line_limit();
+    if number > usize::MAX as u64
+        || old_len > limit as u64
+        || (new_len != u64::MAX && new_len > limit as u64)
+    {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "CDIFF edit exceeds configured line bound",
+        ));
+    }
+    let mut original = vec![0; old_len as usize];
+    input.read_exact(&mut original)?;
+    let new_line = if new_len == u64::MAX {
+        None
+    } else {
+        let mut replacement = vec![0; new_len as usize];
+        input.read_exact(&mut replacement)?;
+        Some(replacement)
+    };
+    Ok(Some(EditNode {
+        line_no: number as usize,
+        orig_line: original,
+        new_line,
+    }))
+}
+
+fn update_line_limit() -> usize {
+    // The integration's policy-calculated limit is passed explicitly. Ordinary
+    // upstream callers retain their historical accepted-line behavior.
+    std::env::var("CLAMAV_UPDATE_MAX_LINE_BYTES")
+        .ok()
+        .and_then(|value| value.parse::<usize>().ok())
+        .filter(|&value| value > 0)
+        .unwrap_or(usize::MAX)
+}
+
+fn read_line_bounded<R: BufRead>(input: &mut R, out: &mut Vec<u8>) -> std::io::Result<usize> {
+    let limit = update_line_limit();
+    let count = (&mut *input)
+        .take((limit as u64).saturating_add(1))
+        .read_until(b'\n', out)?;
+    if out.len() > limit {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "CDIFF line exceeds configured bound",
+        ));
+    }
+    Ok(count)
+}
+
+fn spill_edits(ctx: &mut Context) -> Result<(), InputError> {
+    if ctx.edits.is_empty() {
+        return Ok(());
+    }
+    let previous = ctx.edits_run.take();
+    let mut old = previous
+        .as_ref()
+        .map(|file| file.reopen().map(BufReader::new))
+        .transpose()
+        .map_err(spill_error)?;
+    let mut output = tempfile::Builder::new()
+        .prefix(".cdiff-edits-")
+        .tempfile_in("./")
+        .map_err(spill_error)?;
+    let mut writer = BufWriter::new(output.as_file_mut());
+    let mut old_edit = match old.as_mut() {
+        Some(file) => read_edit(file).map_err(spill_error)?,
+        None => None,
+    };
+    let mut incoming = std::mem::take(&mut ctx.edits).into_iter();
+    let mut new_edit = incoming.next().map(|(_, edit)| edit);
+    while old_edit.is_some() || new_edit.is_some() {
+        let ordering = match (&old_edit, &new_edit) {
+            (Some(old), Some(new)) => old.line_no.cmp(&new.line_no),
+            (Some(_), None) => std::cmp::Ordering::Less,
+            _ => std::cmp::Ordering::Greater,
+        };
+        if ordering == std::cmp::Ordering::Less {
+            write_edit(&mut writer, &old_edit.take().unwrap()).map_err(spill_error)?;
+            old_edit = read_edit(old.as_mut().unwrap()).map_err(spill_error)?;
+        } else {
+            write_edit(&mut writer, &new_edit.take().unwrap()).map_err(spill_error)?;
+            new_edit = incoming.next().map(|(_, edit)| edit);
+            if ordering == std::cmp::Ordering::Equal {
+                old_edit = read_edit(old.as_mut().unwrap()).map_err(spill_error)?;
+            }
+        }
+    }
+    writer.flush().map_err(spill_error)?;
+    drop(writer);
+    ctx.edits_run = Some(output);
+    ctx.edit_bytes = 0;
+    Ok(())
+}
+
+fn insert_edit(ctx: &mut Context, edit: EditNode) -> Result<(), InputError> {
+    let bytes = edit
+        .orig_line
+        .len()
+        .saturating_add(edit.new_line.as_ref().map_or(0, Vec::len))
+        .saturating_add(128);
+    if ctx.edit_bytes.saturating_add(bytes) > EDIT_WINDOW_BYTES {
+        spill_edits(ctx)?;
+    }
+    // Overcounting replaced nodes only causes an earlier spill.
+    ctx.edit_bytes = ctx.edit_bytes.saturating_add(bytes);
+    ctx.edits.insert(edit.line_no, edit);
+    if ctx.edit_bytes >= EDIT_WINDOW_BYTES {
+        spill_edits(ctx)?;
+    }
+    Ok(())
 }
 
