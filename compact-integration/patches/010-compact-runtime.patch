+/* Allocation addresses intentionally run opposite to source order. Repeated
+ * names must remain distinct occurrences, and equally sized candidate heads
+ * must use the same source policy as each next_same chain. */
+START_TEST(test_ac_source_occurrence_order)
+{
+    enum { COUNT = 18 };
+    struct cli_matcher *root = ctx.engine->root[0];
+    struct cli_ac_patt *patterns[COUNT];
+    struct cli_ac_patt records[COUNT];
+    static const char *hex[] = {"41424344??46", "414243??4546", "414243444546"};
+    struct cli_ac_node *node;
+    struct cli_ac_list *head, *entry;
+    unsigned i, j, group;
+    const unsigned char anchor[] = "ABC";
+
+    root->ac_only = 1;
+    ck_assert_int_eq(cli_ac_init(root, 2, 3, 0), CL_SUCCESS);
+    for (i = 0; i < COUNT; i++) {
+        ck_assert_int_eq(cli_add_content_match_pattern(root, "Source.Repeated", hex[i % 3],
+                                                       0, 0, 0, "*", NULL, 0), CL_SUCCESS);
+        patterns[i] = root->ac_pattable[i];
+        patterns[i]->sigid = i;
+        records[i] = *patterns[i];
+    }
+    /* Sort only the fixture's allocation addresses, largest first. */
+    for (i = 1; i < COUNT; i++) {
+        struct cli_ac_patt *p = patterns[i];
+        for (j = i; j && (uintptr_t)patterns[j - 1] < (uintptr_t)p; j--)
+            patterns[j] = patterns[j - 1];
+        patterns[j] = p;
+    }
+    /* Relocate only this fixture's already-created records to reverse their
+     * addresses, keeping every owned payload and source occurrence intact. All
+     * records share the ABC trie anchor and have no relative-offset aliases. */
+    for (i = 0; i < COUNT; i++) {
+        *patterns[i] = records[i];
+        root->ac_pattable[i] = patterns[i];
+    }
+    for (i = 0; i < root->ac_lists; i++) {
+        struct cli_ac_list *item = root->ac_listtable[i];
+        ck_assert_uint_lt(item->source_order, COUNT);
+        item->me = patterns[item->source_order];
+    }
+    ck_assert_int_eq(cli_ac_buildtrie(root), CL_SUCCESS);
+    node = root->ac_root;
+    for (i = 0; i < sizeof(anchor) - 1; i++) {
+#ifdef CLI_AC_FLAT_NODES
+        node = root->ac_flatnodes + node->trans[anchor[i]];
+#elif defined(CLI_AC_NODE_IDS)
+        node = root->ac_nodeidx[node->trans[anchor[i]]];
+#else
+        node = node->trans[anchor[i]];
+#endif
+    }
+    head = node->list;
+    for (group = 0; group < 3; group++) {
+        ck_assert_ptr_nonnull(head);
+        entry = head;
+        for (i = group; i < COUNT; i += 3) {
+            ck_assert_ptr_nonnull(entry);
+            ck_assert_uint_eq(entry->me->sigid, i);
+            if (entry != head) ck_assert_ptr_null(entry->next);
+            entry = entry->next_same;
+        }
+        ck_assert_ptr_null(entry);
+        head = head->next;
+    }
+    ck_assert_ptr_null(head);
+}
+END_TEST
