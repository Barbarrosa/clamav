+        ck_assert_uint_eq((root.ac_lsig_offsets[i + 1] - root.ac_lsig_offsets[i]), widths[i]);
+#else
+        ck_assert_ptr_null(root.ac_lsig_offsets);
+#endif
+        slots += widths[i];
+    }
+#ifdef ENABLE_COMPACT_LSIG_STATE
+    ck_assert_uint_eq(root.ac_lsig_slots, slots);
