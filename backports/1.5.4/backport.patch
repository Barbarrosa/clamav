+    const char*more[]={"CL_TYPE_MSOLE2","CL_TYPE_MSOXML","CL_TYPE_OOXML_WORD","CL_TYPE_OOXML_PPT","CL_TYPE_OOXML_XL","CL_TYPE_OOXML_HWP","CL_TYPE_MAIL","CL_TYPE_ZIP","CL_TYPE_RAR","CL_TYPE_7Z","CL_TYPE_RTF",NULL};
