+/* Byte bounds differ from token counts for multi-byte alternatives and can
+ * sit on either side of the trie anchor. Also cover discarded extensions,
+ * retained non-special extensions, and exact-buffer/short-buffer matching. */
+static const struct {
+    const char *hex, *short_match, *long_match, *offset;
+    unsigned min, max, prefix_min, prefix_max;
+    bool extension;
+} ac_length_cases[] = {
+    {"616263646566", "abcdef", "abcdef", "0", 6, 6, 0, 0, false},
+    {"??61626364", "zabcd", "zabcd", "0", 5, 5, 1, 1, false},
+    {"616263(6465|66676869)", "abcde", "abcfghi", "0", 5, 7, 0, 0, true},
+    /* At offset zero the existing unsigned offset-range check rejects the
+     * short alternative. Use offset two to exercise both valid branches. */
+    {"(6162|63646566)676869", "zzabghi", "zzcdefghi", "2", 5, 7, 2, 4, true},
+    {"616263(6465|6667)", "abcde", "abcfg", "0", 5, 5, 0, 0, true},
+    {"(W)61626364", "abcd", "abcd", "0", 4, 4, 0, 0, true},
+    {"616263!(64|65)", "abcf", "abcg", "0", 4, 4, 0, 0, true},
+};
+
+START_TEST(test_ac_length_bounds)
+{
+    struct cli_matcher *root = ctx.engine->root[0];
+    struct cli_ac_data mdata;
+    struct cli_ac_patt *p;
+    unsigned i;
+    const char *samples[2] = {ac_length_cases[_i].short_match, ac_length_cases[_i].long_match};
+
+    root->ac_only = 1;
+    ck_assert_int_eq(cli_ac_init(root, CLI_DEFAULT_AC_MINDEPTH, CLI_DEFAULT_AC_MAXDEPTH, 1), CL_SUCCESS);
+    ck_assert_int_eq(cli_ac_addsig(root, "LengthBounds", ac_length_cases[_i].hex,
+                                  0, 0, 0, 0, 0, 0, 0, 0, ac_length_cases[_i].offset, NULL, 0), CL_SUCCESS);
+    ck_assert_uint_eq(root->ac_patterns, 1);
+    p = root->ac_pattable[0];
+    ck_assert_int_eq(p->ext != NULL, ac_length_cases[_i].extension);
+    ck_assert_uint_eq(AC_PATT_MINLEN(p) + AC_PATT_PREFIX_MINLEN(p), ac_length_cases[_i].min);
+    ck_assert_uint_eq(AC_PATT_MAXLEN(p) + AC_PATT_PREFIX_MAXLEN(p), ac_length_cases[_i].max);
+    ck_assert_uint_eq(AC_PATT_PREFIX_MINLEN(p), ac_length_cases[_i].prefix_min);
+    ck_assert_uint_eq(AC_PATT_PREFIX_MAXLEN(p), ac_length_cases[_i].prefix_max);
+    ck_assert_uint_eq(root->maxpatlen, ac_length_cases[_i].max);
+    ck_assert_int_eq(cli_ac_buildtrie(root), CL_SUCCESS);
+    ck_assert_int_eq(cli_ac_initdata(&mdata, root->ac_partsigs, 0, 0, CLI_DEFAULT_AC_TRACKLEN), CL_SUCCESS);
+    for (i = 0; i < 2; i++) {
+        ck_assert_int_eq(cli_ac_scanbuff((const unsigned char *)samples[i], strlen(samples[i]),
+                                        &virname, NULL, NULL, root, &mdata, 0, 0, NULL, AC_SCAN_VIR, NULL), CL_VIRUS);
+        ck_assert_str_eq(virname, "LengthBounds.UNOFFICIAL");
+    }
+    ck_assert_int_eq(cli_ac_scanbuff((const unsigned char *)samples[0], strlen(samples[0]) - 1,
+                                    &virname, NULL, NULL, root, &mdata, 0, 0, NULL, AC_SCAN_VIR, NULL), CL_CLEAN);
+    cli_ac_freedata(&mdata);
+}
+END_TEST
