+START_TEST(test_ac_length_bounds_relative_offsets)
+{
+    struct cli_matcher *root = ctx.engine->root[0];
+    struct cli_ac_data mdata;
+    struct cli_target_info info = {0};
+    const char *hex = "616263(6465|66676869)";
+
+    root->ac_only = 1;
+    ck_assert_int_eq(cli_ac_init(root, CLI_DEFAULT_AC_MINDEPTH, CLI_DEFAULT_AC_MAXDEPTH, 1), CL_SUCCESS);
+    /* Four tokens need at least five bytes. EOF-4 must be rejected by the
+     * byte bound, while EOF-5 may match despite a seven-byte maximum. */
+    ck_assert_int_eq(cli_ac_addsig(root, "TooShort", hex, 0, 0, 0, 0, 0, 0, 0, 0, "EOF-4", NULL, 0), CL_SUCCESS);
+    ck_assert_int_eq(cli_ac_addsig(root, "Fits", hex, 0, 0, 0, 0, 0, 0, 0, 0, "EOF-5", NULL, 0), CL_SUCCESS);
+    ck_assert_uint_eq(root->ac_reloff_num, 2);
+    ck_assert_int_eq(cli_ac_initdata(&mdata, 0, 0, root->ac_reloff_num, CLI_DEFAULT_AC_TRACKLEN), CL_SUCCESS);
+    info.fsize = 10;
+    ck_assert_int_eq(cli_ac_caloff(root, &mdata, &info), CL_SUCCESS);
+    ck_assert_uint_eq(mdata.offset[root->ac_reloff[0]->offset_min], CLI_OFF_NONE);
+    ck_assert_uint_eq(mdata.offset[root->ac_reloff[1]->offset_min], 5);
+    cli_ac_freedata(&mdata);
+}
+END_TEST
