+START_TEST(test_ac_length_bounds_constructor_defaults)
+{
+    struct cli_matcher *root = ctx.engine->root[0];
+    struct cli_ac_patt p = {0};
+    struct cli_ac_patt_ext *ext;
+
+    /* Literal patterns with no extension derive the exact byte counts. */
+    p.length = UINT16_MAX;
+    p.prefix_length = 7;
+    ck_assert_uint_eq(AC_PATT_MINLEN(&p), UINT16_MAX);
+    ck_assert_uint_eq(AC_PATT_MAXLEN(&p), UINT16_MAX);
+    ck_assert_uint_eq(AC_PATT_PREFIX_MINLEN(&p), 7);
+    ck_assert_uint_eq(AC_PATT_PREFIX_MAXLEN(&p), 7);
+
+    /* Macro and regex-suffix constructors create a zeroed extension. They
+     * must retain zero byte bounds, even though token counts are nonzero. */
+    ext = cli_ac_patt_ext_new(root, &p);
+    ck_assert_ptr_nonnull(ext);
+    ck_assert_uint_eq(AC_PATT_MINLEN(&p), 0);
+    ck_assert_uint_eq(AC_PATT_MAXLEN(&p), 0);
+    ck_assert_uint_eq(AC_PATT_PREFIX_MINLEN(&p), 0);
+    ck_assert_uint_eq(AC_PATT_PREFIX_MAXLEN(&p), 0);
+    ext->length[1] = UINT16_MAX;
+    ck_assert_ptr_eq(cli_ac_patt_ext_new(root, &p), ext);
+    ck_assert_uint_eq(AC_PATT_MAXLEN(&p), UINT16_MAX);
+    MPOOL_FREE(root->mempool, ext);
+}
+END_TEST
