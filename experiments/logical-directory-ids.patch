+}
+
+static inline void cli_ac_lsigtable_free(struct cli_matcher *root)
+{
+#if defined(ENABLE_LSIG_DIRECTORY_IDS) && SIZEOF_VOID_P == 8
+    if (root->ac_heap_tables & CLI_AC_LSIG_DIRECTORY_PACKED) {
