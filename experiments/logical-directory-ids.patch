+#!/usr/bin/env python3
+"""Exact pointer/order/null and fallback tests of the private directory format.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+from pathlib import Path
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+PROBE = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+static int fail_alloc;
+static void *allocate(size_t n) { return fail_alloc ? NULL : malloc(n); }
+#define CLI_LSIG_DIRECTORY_ALLOC allocate
+#include "lsig-directory.h"
+static void check(struct cli_ac_lsig **table,size_t n) {
+    struct cli_lsig_directory *out=cli_lsig_directory_pack(table,n);assert(out);
+    for (size_t i=0;i<n;i++) assert(cli_lsig_directory_at(out,i)==table[i]);
+    free(out);
+}
+int main(int argc,char **argv) {
+    assert(argc==2);
+    struct cli_ac_lsig *mixed[]={ (void *)(uintptr_t)0x10000,NULL,(void *)(uintptr_t)0x10010,(void *)(uintptr_t)0x10000 };
+    struct cli_ac_lsig *nulls[]={ NULL,NULL,NULL,NULL };
+    if (!strcmp(argv[1],"roundtrip")) {
+        check(mixed,4);check(nulls,4);
+        struct cli_ac_lsig **large=malloc(32768*sizeof(*large));assert(large);
+        for (size_t i=0;i<32768;i++) large[i]=i%7?(void *)(uintptr_t)(0x100000+24*(32767-i)):NULL;
+        check(large,32768);free(large);
+    } else if (!strcmp(argv[1],"bounds")) {
+        struct cli_ac_lsig *edge[]={ (void *)(uintptr_t)1,(void *)(uintptr_t)UINT32_MAX,NULL,(void *)(uintptr_t)8 };
+        check(edge,4);
+        edge[1]=(void *)(uintptr_t)((uint64_t)UINT32_MAX+1);assert(!cli_lsig_directory_pack(edge,4));
+        struct cli_ac_lsig *high[]={ (void *)(uintptr_t)UINTPTR_MAX,NULL,NULL,NULL };
+        check(high,4);
+        assert(!cli_lsig_directory_pack(mixed,0));
+        assert(!cli_lsig_directory_pack(NULL,4));
+        assert(!cli_lsig_directory_pack(mixed,SIZE_MAX));
+        assert(!cli_lsig_directory_pack(mixed,2));
+    } else if (!strcmp(argv[1],"failure")) {
+        struct cli_ac_lsig *before[4];memcpy(before,mixed,sizeof mixed);
+        fail_alloc=1;assert(!cli_lsig_directory_pack(mixed,4));
+        assert(!memcmp(before,mixed,sizeof mixed));
+        fail_alloc=0;check(mixed,4);
+    } else abort();
+    return 0;
+}
+'''
+
+
+@unittest.skipUnless(shutil.which('cc'), 'C compiler required')
+class LogicalDirectoryTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory = tempfile.TemporaryDirectory()
+        cls.path = Path(cls.directory.name)
+        (cls.path / 'probe.c').write_text(PROBE)
+        cls.binary = cls.path / 'probe'
+        subprocess.run(['cc', '-std=c11', '-O2', '-Wall', '-Wextra', '-Werror',
+                        '-I' + str(ROOT / 'libclamav'), str(cls.path / 'probe.c'),
+                        '-o', str(cls.binary)], check=True, capture_output=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.directory.cleanup()
+
+    def run_mode(self, mode):
+        subprocess.run([str(self.binary), mode], check=True, timeout=5, capture_output=True)
+
+    def test_duplicate_identity_nulls_and_exact_order(self):
+        self.run_mode('roundtrip')
+
+    def test_offset_and_integer_boundaries(self):
+        self.run_mode('bounds')
+
+    def test_failed_optional_allocation_keeps_input(self):
+        self.run_mode('failure')
+
+    def test_sanitized_pointer_directory(self):
+        binary = self.path / 'sanitized'
+        subprocess.run(['cc', '-std=c11', '-O1', '-g', '-fsanitize=address,undefined',
+                        '-I' + str(ROOT / 'libclamav'), str(self.path / 'probe.c'),
+                        '-o', str(binary)], check=True, capture_output=True)
+        env = os.environ.copy()
+        env['ASAN_OPTIONS'] = 'detect_leaks=0'
+        for mode in ('roundtrip', 'bounds', 'failure'):
+            subprocess.run([str(binary), mode], check=True, timeout=5, env=env, capture_output=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
