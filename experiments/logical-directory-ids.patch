diff --git a/libclamav/lsig-directory.h b/libclamav/lsig-directory.h
new file mode 100644
index 0000000..c7871ac
--- /dev/null
+++ b/libclamav/lsig-directory.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Optional post-build directory packing. The logical records do not move.
+ */
+#ifndef CLAMAV_LSIG_DIRECTORY_H
+#define CLAMAV_LSIG_DIRECTORY_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+
+struct cli_ac_lsig;
+struct cli_lsig_directory {
+    uintptr_t base;
+    uint32_t offsets[];
+};
+
+#ifndef CLI_LSIG_DIRECTORY_ALLOC
+#define CLI_LSIG_DIRECTORY_ALLOC malloc
+#endif
+
+/* NULL is an optional-optimization refusal: input ownership remains unchanged.
+ * UINT32_MAX encodes a NULL entry, rather than a record at that offset. */
+static inline struct cli_lsig_directory *cli_lsig_directory_pack(
+    struct cli_ac_lsig *const *table, size_t count)
+{
+    uintptr_t low = UINTPTR_MAX, high = 0;
+    size_t i;
+    struct cli_lsig_directory *out;
+    if (!table || !count || sizeof(void *) != 8 ||
+        count > (SIZE_MAX - sizeof(*out)) / sizeof(uint32_t) ||
+        count * (sizeof(void *) - sizeof(uint32_t)) <= sizeof(*out))
+        return NULL;
+    for (i = 0; i < count; i++) {
+        uintptr_t value = (uintptr_t)table[i];
+        if (!value) continue;
+        if (value < low) low = value;
+        if (value > high) high = value;
+    }
+    if (!high) low = 0;
+    if (high - low >= UINT32_MAX) return NULL;
+    out = (struct cli_lsig_directory *)CLI_LSIG_DIRECTORY_ALLOC(sizeof(*out) + count * sizeof(uint32_t));
+    if (!out) return NULL;
+    out->base = low;
+    for (i = 0; i < count; i++)
+        out->offsets[i] = table[i] ? (uint32_t)((uintptr_t)table[i] - low) : UINT32_MAX;
+    return out;
+}
+
+static inline struct cli_ac_lsig *cli_lsig_directory_at(
+    const struct cli_lsig_directory *directory, size_t index)
+{
+    uint32_t offset = directory->offsets[index];
+    return offset == UINT32_MAX ? NULL : (struct cli_ac_lsig *)(directory->base + offset);
+}
+#endif
