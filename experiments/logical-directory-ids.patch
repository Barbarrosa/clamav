@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Test whether exact-size logical-directory copies actually reduce RSS.
+
+This copies the production pool allocator into a temporary isolated C harness.
+Only its unrelated logging/hex dependencies are stubbed. No scanner or runtime
+representation is changed. Linux/LP64 experiment, not a scanner performance test.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import resource
+import shutil
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[2]
+HARNESS = r'''
+#include <assert.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include "mpool.c"
+
+static size_t rss_kib(void) {
+    FILE *f = fopen("/proc/self/smaps_rollup", "r"); assert(f);
+    char line[256]; size_t value = 0;
+    while (fgets(line,sizeof line,f)) if (sscanf(line,"Rss: %zu kB",&value)==1) break;
+    fclose(f); assert(value); return value;
+}
+static size_t resident_pages(const void *ptr,size_t bytes) {
+    const size_t page=(size_t)sysconf(_SC_PAGESIZE);
+    uintptr_t low=(uintptr_t)ptr & ~(uintptr_t)(page-1);
+    uintptr_t high=((uintptr_t)ptr+bytes+page-1)&~(uintptr_t)(page-1);
+    size_t n=(high-low)/page,total=0;
+    unsigned char *vec=malloc(n); assert(vec);
+    assert(!mincore((void *)low,high-low,vec));
+    for (size_t i=0;i<n;i++) total+=!!(vec[i]&1);
+    free(vec); return total;
+}
+static uint64_t value(size_t i) { return UINT64_C(0xf1e2d3c4a5b60000) ^ (uint64_t)i; }
+int main(int argc,char **argv) {
+    assert(argc==3);
+    size_t count=(size_t)strtoull(argv[1],NULL,10);
+    int force_touch=atoi(argv[2]);
+    assert(count>0 && count<=1000000 && (force_touch==0 || force_touch==1));
+    const size_t page=(size_t)sysconf(_SC_PAGESIZE);
+    (void)rss_kib();
+    mpool_t *mp=mpool_create(); assert(mp);
+    uint64_t *table=NULL;
+    for (size_t i=0;i<count;i++) {
+        uint64_t *next=mpool_realloc(mp,table,(i+1)*sizeof(*table)); assert(next);
+        table=next; table[i]=value(i);
+    }
+    struct FRAG *fragment=(struct FRAG *)((char *)table-FRAG_OVERHEAD);
+    size_t charge=from_bits(fragment->u.a.sbits);
+    size_t capacity=charge-FRAG_OVERHEAD-fragment->u.a.padding;
+    size_t payload=count*sizeof(*table);
+    if (force_touch) memset((char *)table+payload,0x75,capacity-payload);
+    mpool_flush(mp);
+    size_t before_pages=resident_pages(table,capacity);
+    size_t before_rss=rss_kib();
+    uint64_t *copy=malloc(payload); assert(copy);
+    memcpy(copy,table,payload);
+    for (size_t i=0;i<count;i++) assert(copy[i]==value(i));
+    mpool_free(mp,table);
+    mpool_flush(mp);
+    size_t after_rss=rss_kib();
+    size_t copy_pages=resident_pages(copy,payload);
+    printf("{\"rows\":%zu,\"pointer_bytes\":%zu,\"page_bytes\":%zu,"
+           "\"payload_bytes\":%zu,\"old_fragment_charge_bytes\":%zu,"
+           "\"old_usable_capacity_bytes\":%zu,\"spare_capacity_bytes\":%zu,"
+           "\"old_fragment_resident_pages_before_copy\":%zu,"
+           "\"new_copy_resident_pages\":%zu,\"before_rss_kib\":%zu,"
+           "\"after_rss_kib\":%zu,\"rss_saving_bytes\":%" PRId64 ","
+           "\"entire_old_capacity_forced_resident\":%s,"
+           "\"all_values_and_order_equal\":true}\n",
+           count,sizeof(void *),page,payload,charge,capacity,capacity-payload,
+           before_pages,copy_pages,before_rss,after_rss,
+           ((int64_t)before_rss-(int64_t)after_rss)*1024,force_touch?"true":"false");
+    free(copy);mpool_destroy(mp);return 0;
+}
+'''
+
+
+def limit_child():
+    resource.setrlimit(resource.RLIMIT_AS, (2 * 1024**3, 2 * 1024**3))
+    resource.setrlimit(resource.RLIMIT_CPU, (30, 35))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=ROOT / 'libclamav')
+    parser.add_argument('--rows', type=int, nargs='+', default=[297075])
+    parser.add_argument('--report', type=Path, required=True)
+    args = parser.parse_args()
+    if any(n < 1 or n > 1000000 for n in args.rows):
+        parser.error('rows must be within 1..1000000')
+    spec = importlib.util.spec_from_file_location('mpool_headers', ROOT / 'tools/compact-memory/test_mpool_flush.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    sources = {name: hashlib.sha256((args.source / name).read_bytes()).hexdigest()
+               for name in ('mpool.c', 'mpool.h', 'memory_perturb.h')}
+    with tempfile.TemporaryDirectory() as name:
+        work = Path(name)
+        for path in sources:
+            shutil.copy2(args.source / path, work / path)
+        for name, content in module.HEADERS.items():
+            (work / name).write_text(content)
+        (work / 'probe.c').write_text(HARNESS)
+        flags = ['-std=c11', '-D_DEFAULT_SOURCE', '-DUSE_MPOOL', '-DHAVE_UNISTD_H=1',
+                 '-DHAVE_STRING_H=1', '-DHAVE_MMAP=1', '-DHAVE_SYS_MMAN_H=1',
+                 '-DHAVE_MADVISE=1', '-DSIZEOF_VOID_P=8', '-DC_LINUX=1',
+                 '-DANONYMOUS_MAP=MAP_ANONYMOUS', '-ffunction-sections',
+                 '-fdata-sections', '-Wl,--gc-sections', '-O2']
+        subprocess.run(['cc', *flags, 'probe.c', '-o', 'probe'], cwd=work, check=True, capture_output=True)
+        cases = []
+        for rows in args.rows:
+            for touch in (0, 1):
+                raw = subprocess.check_output([str(work / 'probe'), str(rows), str(touch)],
+                                              text=True, timeout=60, preexec_fn=limit_child)
+                cases.append(json.loads(raw))
+    result = {'schema_version': 1,
+              'scope': 'Isolated production-pool directory growth/copy experiment; not a scanner integration or performance qualification.',
+              'implementation_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              'allocator_source_sha256': sources,
+              'harness_sha256': hashlib.sha256(HARNESS.encode()).hexdigest(),
+              'cases': cases,
+              'limitations': ['The directory alone does not reproduce full-engine interleaving or allocator reuse.',
+                              'Forced-resident spare capacity is an artificial sensitivity case, not observed engine residency.',
+                              'RSS observations include small libc/page-accounting variation.',
+                              'Logical record/descriptor sharing is not implemented or validated here.']}
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(result, indent=2) + '\n')
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
