diff --git a/tools/compact-memory/test_tight_pool_classes.py b/tools/compact-memory/test_tight_pool_classes.py
new file mode 100644
index 0000000..208c889
--- /dev/null
+++ b/tools/compact-memory/test_tight_pool_classes.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""Exercise experimental classes in the actual pool allocator.
+
+Both modes compile the production mpool.c, with small external compatibility
+stubs. This checks allocator correctness and table arithmetic; it does not
+qualify scanner ordering, whole-engine RAM or performance.
+SPDX-License-Identifier: GPL-2.0-only
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+HARNESS = r'''
+#include <assert.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdint.h>
+#include "mpool.c"
+
+static void check_table(void) {
+    assert(FRAGSBITS <= 255);
+    assert(from_bits(FRAGSBITS) == 0);
+    for (unsigned i=0; i<FRAGSBITS; ++i) {
+        assert(fragsz[i] >= 1);
+        assert(!i || fragsz[i] > fragsz[i-1]);
+        assert(to_bits(fragsz[i]) == i);
+        assert(to_bits(i ? fragsz[i-1]+1 : 0) == i);
+        assert(from_bits(i) == fragsz[i]);
+    }
+    assert(to_bits(fragsz[FRAGSBITS-1]+1) == FRAGSBITS);
+}
+
+static void bytes_equal(const unsigned char *p, size_t count, unsigned char byte) {
+    for (size_t i=0; i<count; ++i) assert(p[i] == byte);
+}
+
+int main(void) {
+    check_table();
+    printf("{\"pointer_table\":%u,\"classes\":[", SIZEOF_VOID_P);
+    for (unsigned i=0; i<FRAGSBITS; ++i) printf("%s%u", i ? "," : "", fragsz[i]);
+    printf("],\"pool_header_bytes\":%zu", sizeof(struct MP));
+#if SIZEOF_VOID_P == 8
+    assert(sizeof(void*) == 8);
+    const size_t sizes[] = {1,2,4,8,24,32,48,96,152,153,154,160,168,176,
+                            184,185,192,196,200,1016,1024,1032,1040,1041,1056,1176};
+    unsigned checked=0;
+    for (unsigned s=0; s<sizeof(sizes)/sizeof(sizes[0]); ++s) {
+        for (unsigned residue=0; residue<8; ++residue) {
+            mpool_t *mp=mpool_create(); assert(mp);
+            mp->u.mpm.usize += 16 + ((residue+8-mp->u.mpm.usize%8)%8);
+            size_t before=mp->u.mpm.usize;
+            unsigned char *p=mpool_calloc(mp,1,sizes[s]); assert(p);
+            assert((uintptr_t)p % alignof(sizes[s]) == 0);
+            bytes_equal(p,sizes[s],0); memset(p,0x6c,sizes[s]);
+            struct FRAG *f=(struct FRAG*)(p-FRAG_OVERHEAD);
+            size_t charge=from_bits(f->u.a.sbits);
+            assert(charge == mp->u.mpm.usize-before);
+            assert(charge >= sizes[s]+FRAG_OVERHEAD+f->u.a.padding);
+            unsigned bucket=f->u.a.sbits;
+            void *base=allocbase_fromfrag(f);
+            mpool_free(mp,p);
+            assert(mp->avail[bucket] == base);
+            /* Pop only the exact worst-case lookup class, as production does. */
+            unsigned lookup=to_bits(align_increase(sizes[s]+FRAG_OVERHEAD,alignof(sizes[s])));
+            unsigned char *q=mpool_malloc(mp,sizes[s]); assert(q);
+            assert((q==p) == (lookup==bucket));
+            memset(q,0x3d,sizes[s]); bytes_equal(q,sizes[s],0x3d);
+            mpool_destroy(mp); ++checked;
+        }
+    }
+
+    /* Exercise realloc growth, shrink, in-place reuse, zero and calloc through
+     * the new boundaries. Multiples of eight preserve each pointer's original
+     * alignment requirement, avoiding reliance on legacy realloc's size-based
+     * inference for a stronger alignment than the original allocation. */
+    mpool_t *mp=mpool_create(); assert(mp);
+    const size_t steps[]={160,168,176,184,192,200,1016,1024,1032,1040,1048,1176,1024,168};
+    unsigned char *p=NULL; size_t old=0;
+    for (unsigned i=0;i<sizeof(steps)/sizeof(steps[0]);++i) {
+        unsigned char *q=mpool_realloc(mp,p,steps[i]); assert(q);
+        bytes_equal(q,old<steps[i]?old:steps[i],0x5a);
+        assert((uintptr_t)q%8==0);
+        memset(q,0x5a,steps[i]); p=q;old=steps[i];
+    }
+    assert(mpool_realloc(mp,p,0)==NULL); bytes_equal(p,old,0x5a);
+    mpool_free(mp,p);
+    assert(mpool_calloc(mp,0,8)==NULL);
+    assert(mpool_calloc(mp,8,0)==NULL);
+    mpool_flush(mp);
+    mpool_destroy(mp);
+
+    /* Fixed rows have one class for every starting alignment. */
+    mp=mpool_create(); assert(mp);
+    p=mpool_malloc(mp,1024); assert(p);
+    unsigned row_charge=from_bits(((struct FRAG*)(p-FRAG_OVERHEAD))->u.a.sbits);
+    p=mpool_malloc(mp,168); assert(p);
+    unsigned logical_charge=from_bits(((struct FRAG*)(p-FRAG_OVERHEAD))->u.a.sbits);
+    printf(",\"alignment_cases\":%u,\"row_charge\":%u,\"logical_charge\":%u",
+           checked,row_charge,logical_charge);
+    mpool_destroy(mp);
+#endif
+    puts(",\"checks\":\"passed\"}");
+    return 0;
+}
+'''
+
+
+def compatibility_module():
+    spec = importlib.util.spec_from_file_location('mpool_flush', ROOT / 'tools/compact-memory/test_mpool_flush.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def run_harness(*, tight, pointer_table=8, sanitize=False, flush=False):
+    module = compatibility_module()
+    with tempfile.TemporaryDirectory() as name:
+        work = Path(name)
+        for file in ('mpool.c', 'mpool.h', 'memory_perturb.h'):
+            shutil.copy2(ROOT / 'libclamav' / file, work / file)
+        for file, content in module.HEADERS.items():
+            (work / file).write_text(content)
+        (work / 'probe.c').write_text(module.HARNESS if flush else HARNESS)
+        command = ['cc', '-std=c11', '-D_DEFAULT_SOURCE', '-DUSE_MPOOL',
+                   '-DHAVE_UNISTD_H=1', '-DHAVE_STRING_H=1', '-DHAVE_MMAP=1',
+                   '-DHAVE_SYS_MMAN_H=1', '-DHAVE_MADVISE=1', '-DC_LINUX=1',
+                   '-DANONYMOUS_MAP=MAP_ANONYMOUS', f'-DSIZEOF_VOID_P={pointer_table}',
+                   '-ffunction-sections', '-fdata-sections', '-Wl,--gc-sections',
+                   '-O2', 'probe.c', '-o', 'probe']
+        if tight: command.insert(1, '-DENABLE_TIGHT_POOL_CLASSES=1')
+        if sanitize: command[1:1] = ['-fsanitize=address,undefined', '-fno-omit-frame-pointer']
+        subprocess.run(command, cwd=work, check=True, capture_output=True)
+        import os
+        env = os.environ.copy()
+        if sanitize: env['ASAN_OPTIONS'] = 'detect_leaks=0'
+        result = subprocess.run([str(work/'probe')], check=True, capture_output=True, text=True, env=env)
+        return json.loads(result.stdout)
+
+
+@unittest.skipUnless(shutil.which('cc'), 'C compiler needed')
+class TightPoolClassTests(unittest.TestCase):
+    def test_lp64_table_boundaries_alignment_reuse_and_reallocation(self):
+        baseline=run_harness(tight=False)
+        trial=run_harness(tight=True)
+        self.assertEqual(trial['classes'], sorted(baseline['classes']+[184,1040]))
+        self.assertEqual(trial['pool_header_bytes']-baseline['pool_header_bytes'],16)
+        self.assertEqual((baseline['row_charge'],trial['row_charge']),(1176,1040))
+        self.assertEqual((baseline['logical_charge'],trial['logical_charge']),(196,184))
+        self.assertEqual(trial['alignment_cases'],208)
+
+        spec=importlib.util.spec_from_file_location('class_analysis',ROOT/'tools/compact-memory/allocation-perturbation/pool_class_analysis.py')
+        analysis=importlib.util.module_from_spec(spec);spec.loader.exec_module(analysis)
+        self.assertEqual(analysis.inspect_source(ROOT/'libclamav/mpool.c'),baseline['classes'])
+        self.assertEqual(analysis.inspect_source(ROOT/'libclamav/mpool.c',tight_pool_classes=True),trial['classes'])
+
+    def test_native_32bit_table_selection_is_unchanged(self):
+        # This selects and checks the production 32-bit table on the host. It
+        # does not claim to execute a 32-bit allocator or qualify its ABI.
+        baseline=run_harness(tight=False,pointer_table=4)
+        trial=run_harness(tight=True,pointer_table=4)
+        self.assertEqual(trial['classes'],baseline['classes'])
+        self.assertEqual(trial['pool_header_bytes'],baseline['pool_header_bytes'])
+
+    def test_production_free_page_reclamation_and_failure_preserve_reuse(self):
+        self.assertEqual(run_harness(tight=True,flush=True)['checks'],'passed')
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--report',type=Path)
+    parser.add_argument('--sanitize',action='store_true')
+    args=parser.parse_args()
+    rows={}
+    for name,tight in (('baseline',False),('tight',True)):
+        rows[name]=run_harness(tight=tight,sanitize=args.sanitize)
+        rows[name+'_flush']=run_harness(tight=tight,sanitize=args.sanitize,flush=True)
+    rows['source_sha256']=hashlib.sha256((ROOT/'libclamav/mpool.c').read_bytes()).hexdigest()
+    rows['sanitizers']=args.sanitize
+    rows['scope']='Production allocator invariants only; scanner order, engine RSS and baseline performance unqualified.'
+    if args.report:
+        args.report.parent.mkdir(parents=True,exist_ok=True)
+        args.report.write_text(json.dumps(rows,indent=2)+'\n')
+    print(json.dumps({k:rows[k] for k in ('source_sha256','sanitizers','scope')}))
+
+
+if __name__=='__main__':main()
