diff --git a/tools/compact-memory/test_lsig_store.c b/tools/compact-memory/test_lsig_store.c
new file mode 100644
index 0000000..83bb8e7
--- /dev/null
+++ b/tools/compact-memory/test_lsig_store.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Production store + hash table, with individual malloc bounds and failures.
+ * Substitute individual allocation macros so ASan sees every object.
+ */
+#include "clamav-config.h"
+#include "lsig-store.h"
+#include "others.h"
+#include "str.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static long fail_at = -1, calls;
+static void *live[20000];
+static size_t live_count;
+static void *track(void *p) {
+    if (p) { assert(live_count < 20000); live[live_count++] = p; }
+    return p;
+}
+static void test_free(void *p) {
+    if (!p) return;
+    size_t i;
+    for (i = 0; i < live_count && live[i] != p; i++);
+    assert(i < live_count);
+    live[i] = live[--live_count];
+    free(p);
+}
+static void *test_malloc(size_t n) {
+    if (fail_at >= 0 && calls++ == fail_at) return NULL;
+    return track(malloc(n));
+}
+static void *test_calloc(size_t n, size_t w) {
+    if (fail_at >= 0 && calls++ == fail_at) return NULL;
+    return track(calloc(n, w));
+}
+#define free test_free
+#define malloc test_malloc
+#define calloc test_calloc
+#define cli_max_malloc test_malloc
+#define cli_max_calloc test_calloc
+#undef MPOOL_MALLOC
+#undef MPOOL_FREE
+#define MPOOL_MALLOC(pool, size) test_malloc(size)
+#define MPOOL_FREE(pool, ptr) free(ptr)
+#include "../../libclamav/hashtab.c"
+#include "../../libclamav/lsig-store.c"
+#undef free
+#undef malloc
+#undef calloc
+#undef cli_max_malloc
+#undef cli_max_calloc
+static struct cli_lsig_tdb descriptor(unsigned n) {
+    struct cli_lsig_tdb d = {0};
+    d.cnt[0] = 4; d.cnt[1] = 4; d.cnt[2] = 6; d.subsigs = 2;
+    d.val = test_calloc(4, 4); d.range = test_calloc(4, 4); d.str = test_malloc(6);
+    d.macro_ptids = test_calloc(2, 4);
+    assert(d.val && d.range && d.str && d.macro_ptids);
+    d.val[0] = n; d.val[1] = 1; d.val[2] = 2; d.val[3] = 3;
+    d.range[0] = 51; d.range[1] = 255; d.range[2] = 9; d.range[3] = 19;
+    memcpy(d.str, "ab\0cd\0", 6); d.macro_ptids[1] = 10;
+    d.target = d.val; d.container = d.val + 1; d.handlertype = d.val + 2;
+    d.intermediates = d.val + 2;
+    d.engine = d.range; d.nos = d.range + 2; d.ep = d.range; d.filesize = d.range + 2;
+    d.icongrp1 = d.str; d.icongrp2 = d.str + 3;
+    return d;
+}
+int main(void) {
+    struct cli_matcher root = {0};
+    const struct cli_lsig_tdb *first = NULL, *p = NULL;
+    unsigned failures = 0;
+    /* Every allocation in a first insertion: failure must retain caller ownership. */
+    for (long at = 0; at < 12; at++) {
+        struct cli_matcher trial = {0}; struct cli_lsig_tdb d = descriptor(1);
+        uint32_t *v = d.val;
+        fail_at = at; calls = 0;
+        cl_error_t ret = cli_lsig_tdb_intern(&trial, &d, &p);
+        fail_at = -1;
+        if (ret != CL_SUCCESS) {
+            assert(ret == CL_EMEM && d.val == v && d.range[3] == 19);
+            assert(cli_lsig_tdb_intern(&trial, &d, &p) == CL_SUCCESS); failures++;
+        }
+        assert(d.val == NULL && p->range[3] == 19);
+        cli_lsig_store_free(&trial); cli_lsig_store_free(&trial);
+    }
+    for (unsigned i = 0; i < 1000; i++) {
+        struct cli_lsig_tdb d = descriptor(i);
+        assert(cli_lsig_tdb_intern(&root, &d, &p) == CL_SUCCESS);
+        if (!i) first = p;
+    }
+    assert(root.lsig_store->descriptors.used == 1000);
+    for (unsigned i = 0; i < 1000; i++) {
+        struct cli_lsig_tdb d = descriptor(i);
+        assert(cli_lsig_tdb_intern(&root, &d, &p) == CL_SUCCESS);
+        assert(p->val[0] == i && !d.val);
+        if (!i) assert(p == first);
+    }
+    /* Each scalar pointer coordinate, count and macro byte is part of equality. */
+    for (unsigned variant = 0; variant < 8; variant++) {
+        struct cli_lsig_tdb d = descriptor(0);
+        switch (variant) {
+            case 0: d.target = NULL; break;
+            case 1: d.target = d.val + 1; break;
+            case 2: d.range[3]++; break;
+            case 3: d.macro_ptids[0]++; break;
+            case 4: test_free(d.macro_ptids); d.macro_ptids = NULL; break;
+            case 5: d.icongrp1 = d.str + 3; break;
+            case 6: d.str[4]++; break;
+            case 7: d.subsigs = 1; break;
+        }
+        assert(cli_lsig_tdb_intern(&root, &d, &p) == CL_SUCCESS && p != first);
+    }
+    struct cli_lsig_tdb bad = descriptor(0);
+    bad.target = bad.val + 4;
+    assert(cli_lsig_tdb_intern(&root, &bad, &p) == CL_EARG && bad.val);
+    cli_lsig_tdb_free(&bad);
+    const char *expression = cli_lsig_expression_intern(&root, "0&1"); assert(expression);
+    for (unsigned i = 0; i < 1000; i++) {
+        char key[40]; snprintf(key, sizeof(key), "0|%u", i);
+        assert(cli_lsig_expression_intern(&root, key));
+    }
+    assert(cli_lsig_expression_intern(&root, "0&1") == expression);
+    assert(cli_lsig_expression_intern(&root, "1&0") != expression);
+    assert(!strcmp(expression, "0&1"));
+    cli_lsig_store_free(&root);
+    assert(live_count == 0);
+    printf("{\"unique_descriptors\":1008,\"duplicate_reuses\":1000,\"allocation_failures_retried\":%u,\"production_hash_and_store\":true,\"individual_allocations\":true,\"tracked_live_allocations_after_free\":0}\n", failures);
+    return 0;
+}
