diff --git a/libclamav/lsig-store.c b/libclamav/lsig-store.c
new file mode 100644
index 0000000..a32207f
--- /dev/null
+++ b/libclamav/lsig-store.c
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only
+ * Immutable logical metadata. Rule order and expression evaluation are unchanged.
+ * The existing string hash tables own construction keys; no table lookup occurs
+ * while scanning. Complete keys, not fingerprints, establish equality.
+ */
+#include "clamav-config.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "lsig-store.h"
+#include "hashtab.h"
+
+const struct cli_lsig_tdb cli_lsig_empty_tdb = {0};
+
+void cli_lsig_tdb_free(struct cli_lsig_tdb *d)
+{
+    if (d->cnt[CLI_TDB_UINT]) MPOOL_FREE(d->mempool, d->val);
+    if (d->cnt[CLI_TDB_RANGE]) MPOOL_FREE(d->mempool, d->range);
+    if (d->cnt[CLI_TDB_STR]) MPOOL_FREE(d->mempool, d->str);
+    if (d->macro_ptids) MPOOL_FREE(d->mempool, d->macro_ptids);
+    memset(d, 0, sizeof(*d));
+}
+
+static struct cli_lsig_store *store(struct cli_matcher *root)
+{
+    struct cli_lsig_store *s = root->lsig_store;
+    if (s) return s;
+    s = calloc(1, sizeof(*s));
+    if (!s) return NULL;
+    if (cli_hashtab_init(&s->descriptors, 64) != CL_SUCCESS ||
+        cli_hashtab_init(&s->expressions, 64) != CL_SUCCESS) {
+        cli_hashtab_free(&s->descriptors);
+        cli_hashtab_free(&s->expressions);
+        free(s);
+        return NULL;
+    }
+    root->lsig_store = s;
+    return s;
+}
+
+/* Hex is only a construction key for the existing NUL-terminated-string table.
+ * This is neither a stored-data codec nor a scan-time representation. */
+static char *key_part(char *out, const void *data, size_t bytes)
+{
+    const unsigned char *p = data;
+    static const char hex[] = "0123456789abcdef";
+    size_t i;
+    for (i = 0; i < bytes; i++) {
+        *out++ = hex[p[i] >> 4];
+        *out++ = hex[p[i] & 15];
+    }
+    return out;
+}
+
+cl_error_t cli_lsig_tdb_intern(struct cli_matcher *root,
+                             struct cli_lsig_tdb *d,
+                             const struct cli_lsig_tdb **out)
+{
+    const void *ptrs[] = {d->target, d->engine, d->nos, d->ep, d->filesize,
+                         d->container, d->handlertype, d->intermediates,
+                         d->icongrp1, d->icongrp2};
+    const unsigned bases[] = {0, 1, 1, 1, 1, 0, 0, 0, 2, 2};
+    const void *data[] = {d->val, d->range, d->str, d->macro_ptids};
+    uint64_t bytes[] = {(uint64_t)d->cnt[0] * sizeof(uint32_t),
+                        (uint64_t)d->cnt[1] * sizeof(uint32_t),
+                        (uint64_t)d->cnt[2],
+                        d->macro_ptids ? (uint64_t)d->subsigs * sizeof(uint32_t) : 0};
+    uint64_t meta[15] = {d->cnt[0], d->cnt[1], d->cnt[2], d->subsigs};
+    uint64_t total = sizeof(meta);
+    struct cli_lsig_store *s;
+    const struct cli_element *entry;
+    struct cli_lsig_tdb *owned;
+    char *key, *p;
+    unsigned i;
+
+    for (i = 0; i < 4; i++) {
+        if (bytes[i] && !data[i]) return CL_EARG;
+        total += bytes[i];
+    }
+    meta[14] = d->macro_ptids != NULL;
+    for (i = 0; i < 10; i++) {
+        unsigned b = bases[i];
+        if (!ptrs[i]) continue;
+        uintptr_t base = (uintptr_t)data[b], ptr = (uintptr_t)ptrs[i];
+        if (!data[b] || ptr < base || (uint64_t)(ptr - base) >= bytes[b]) return CL_EARG;
+        meta[4 + i] = (uint64_t)(ptr - base) + 1; /* zero preserves NULL */
+    }
+    if (total > (SIZE_MAX - 1) / 2) return CL_EMEM;
+    key = cli_max_malloc((size_t)total * 2 + 1);
+    if (!key) return CL_EMEM;
+    p = key_part(key, meta, sizeof(meta));
+    for (i = 0; i < 4; i++) p = key_part(p, data[i], (size_t)bytes[i]);
+    *p = '\0';
+    s = store(root);
+    if (!s) { free(key); return CL_EMEM; }
+    entry = cli_hashtab_find(&s->descriptors, key, (size_t)(p - key));
+    if (entry) {
+        *out = (const struct cli_lsig_tdb *)(uintptr_t)entry->data;
+        cli_lsig_tdb_free(d);
+        free(key);
+        return CL_SUCCESS;
+    }
+    owned = MPOOL_MALLOC(root->mempool, sizeof(*owned));
+    if (!owned) { free(key); return CL_EMEM; }
+    *owned = *d;
+    entry = cli_hashtab_insert(&s->descriptors, key, (size_t)(p - key), (size_t)(uintptr_t)owned);
+    free(key);
+    if (!entry) {
+        MPOOL_FREE(root->mempool, owned);
+        return CL_EMEM; /* caller still owns every parsed allocation */
+    }
+    *out = owned;
+    memset(d, 0, sizeof(*d));
+    return CL_SUCCESS;
+}
+
+const char *cli_lsig_expression_intern(struct cli_matcher *root, const char *expression)
+{
+    struct cli_lsig_store *s = store(root);
+    const struct cli_element *entry;
+    size_t len = strlen(expression);
+    if (!s) return NULL;
+    entry = cli_hashtab_find(&s->expressions, expression, len);
+    if (!entry) entry = cli_hashtab_insert(&s->expressions, expression, len, 0);
+    return entry ? entry->key : NULL;
+}
+
+void cli_lsig_store_free(struct cli_matcher *root)
+{
+    struct cli_lsig_store *s = root->lsig_store;
+    size_t i;
+    if (!s) return;
+    for (i = 0; i < s->descriptors.capacity; i++) {
+        struct cli_element *e = &s->descriptors.htable[i];
+        if (e->key) {
+            struct cli_lsig_tdb *d = (struct cli_lsig_tdb *)(uintptr_t)e->data;
+            cli_lsig_tdb_free(d);
+            MPOOL_FREE(root->mempool, d);
+        }
+    }
+    cli_hashtab_free(&s->descriptors);
+    cli_hashtab_free(&s->expressions);
+    free(s);
+    root->lsig_store = NULL;
+}
