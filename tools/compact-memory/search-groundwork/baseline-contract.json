  "policies": {
    "strict_vs_baseline": {
      "allow_failed": false,
      "allow_unknown_correctness": false,
      "allow_unknown_performance": false,
      "allow_unimplemented": false,
      "allow_asymptotic_lookup_regression": false,
      "allow_rule_omission": false,
      "require_source_bound_whole_engine_validation": true,
      "inheritance_is_empirical_upstream_pass": false
    },
    "exploratory": {
      "allow_failed": false,
      "allow_unknown_correctness": true,
      "allow_unknown_performance": true,
      "allow_unimplemented": true,
      "allow_asymptotic_lookup_regression": false,
      "allow_rule_omission": false,
      "result_label": "research_candidate_not_qualified",
      "require_explicit_relaxation_of_known_failure": true
    }
  },
  "counting_contract": {
    "unit": "One declared configuration selects exactly one choice in each active group. It is not automatically a distinct physical image.",
    "unique_auxiliary_extension_required": true,
    "requirements": [
      "Deterministically define all arithmetic and derived-depth auxiliaries.",
      "Fix inactive-family state instead of leaving it unconstrained.",
      "Use full-equivalence gate encodings, including long-clause replacements.",
      "Reject duplicate choice IDs and contradictory evidence.",
      "Declare any equivalent-description canonicalization before interpreting counts as physical-layout counts."
    ],
    "projection_note": "Ordinary fixed-width model counting does not itself provide projected counting over only genuine selection variables.",
    "linked_algorithm_executed": false
  },
  "evidence_rules": [
    "A timing observation applies only to its recorded source, machine, inputs, options and cache state.",
    "Never add reductions from different experiments or overlapping storage boundaries.",
    "No raw CVD, signature body, name text or pointer constant belongs in public catalogs or formula metadata.",
    "Numerical experiment entries below are scoped observations, not default solver cost coefficients. Missing costs stay null."
  ]
